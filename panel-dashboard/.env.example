# URL base de la API de Laravel (sin barra final)
VITE_API_URL=http://localhost:8000

# Mostrar los módulos del ERP (Inventario, Finanzas, Marketing, etc.).
# Pëtru arranca solo con Catálogo, Pedidos y Consultas. Los demás siguen en el
# repo y se activan cuando el negocio los necesite.
VITE_MOSTRAR_ERP=false

# URL del sitio público, para previsualizar imágenes relativas (/img/...) y abrir fichas
VITE_SITIO_URL=http://localhost:5173
