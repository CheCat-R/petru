APP_NAME="Pëtru"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=petru
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@petru.art"
MAIL_FROM_NAME="Pëtru"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Pëtru ---
# Orígenes permitidos para CORS (sitio público y panel), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# URL pública del sitio, para armar links en emails y en el retorno de MercadoPago
FRONTEND_URL=http://localhost:5173

# MercadoPago (Checkout Pro)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Andreani
ANDREANI_API_URL=https://apis.andreani.com
ANDREANI_USUARIO=
ANDREANI_PASSWORD=
ANDREANI_CLIENTE=
ANDREANI_CP_ORIGEN=2000

# Reserva de stock durante el pago (minutos)
PEDIDO_RESERVA_MINUTOS=30

# Sanctum en modo cookie (SPA): SOLO el panel. El sitio público no usa sesión y si
# figura acá, la API le exige CSRF a sus POST (419). En producción: panel.petru.com.ar
SANCTUM_STATEFUL_DOMAINS=localhost:5174
# En producción, para compartir la cookie entre subdominios: SESSION_DOMAIN=.petru.com.ar

# Casilla del taller: recibe aviso de cada pedido pagado y cada consulta
PETRU_EMAIL_TALLER=taller@petru.art

# Producción (Hostinger): MAIL_MAILER=smtp · MAIL_HOST=smtp.hostinger.com · MAIL_PORT=465
# MAIL_SCHEME=smtps · MAIL_USERNAME=hola@petru.art · MAIL_PASSWORD=...
# Los mails van por cola (QUEUE_CONNECTION=database): el cron corre queue:work cada minuto.

# URL del panel (links en los mails al taller)
PANEL_URL=http://localhost:5174
