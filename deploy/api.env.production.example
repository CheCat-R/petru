# =============================================================================
# Pëtru API — .env de PRODUCCIÓN (Hostinger)
# Copiar a …/domains/api.petru.com.ar/laravel/.env y completar lo marcado con <>.
# NUNCA subir este archivo completo al repo.
# =============================================================================

APP_NAME="Pëtru"
APP_ENV=production
APP_KEY=                      # se genera en el servidor: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.petru.com.ar

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Base de datos: la crea hPanel → Bases de datos → MySQL. El nombre y el usuario
# llevan el prefijo de la cuenta (u123456789_petru).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<u123456789_petru>
DB_USERNAME=<u123456789_petru>
DB_PASSWORD=<contraseña de la base>

# Sesión del panel (Sanctum en modo cookie). El dominio con punto adelante
# para que la cookie de api.petru.com.ar valga en panel.petru.com.ar.
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.petru.com.ar
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=panel.petru.com.ar

# Orígenes que pueden llamar a la API desde el navegador
CORS_ALLOWED_ORIGINS=https://petru.com.ar,https://www.petru.com.ar,https://panel.petru.com.ar
FRONTEND_URL=https://petru.com.ar
PANEL_URL=https://panel.petru.com.ar

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log

# Mail por SMTP de Hostinger. La casilla se crea en hPanel → Emails.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=<hola@petru.com.ar>
MAIL_PASSWORD=<contraseña de la casilla>
MAIL_FROM_ADDRESS="<hola@petru.com.ar>"
MAIL_FROM_NAME="Pëtru"

# A dónde le llegan al taller los avisos de pedidos y consultas
PETRU_EMAIL_TALLER=<taller@petru.com.ar>

# MercadoPago y Andreani se cargan desde el panel (Integraciones). Estas
# variables quedan como respaldo y pueden ir vacías.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_DESCRIPTOR=PETRU
ANDREANI_API_URL=https://apis.andreani.com
ANDREANI_USUARIO=
ANDREANI_PASSWORD=
ANDREANI_CLIENTE=
ANDREANI_CONTRATO=
ANDREANI_CP_ORIGEN=2000

PEDIDO_RESERVA_MINUTOS=30
